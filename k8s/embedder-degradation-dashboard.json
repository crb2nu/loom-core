{
  "annotations": {
    "list": []
  },
  "description": "Agent-context embedder degradation: request failure rate and embedding-dependent search latency.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Document embedding fallbacks divided by write attempts over the selected rate interval. The expression returns no series when there are no attempts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum(rate(agent_context_embed_fallback_writes_total[$__rate_interval])) / sum(rate(agent_context_embed_write_attempts_total[$__rate_interval]))) and sum(rate(agent_context_embed_write_attempts_total[$__rate_interval])) > 0",
          "legendFormat": "failure rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Embedder failure rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Agent-context search latency is the available latency signal for embedding-dependent requests; a dedicated embedding-duration histogram is not currently exported.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "µs"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "agent_context_search_latency_us{quantile=~\"0.5|0.9|0.99\"}",
          "legendFormat": "p{{quantile}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Embedding-dependent search latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "loom",
    "agent-context",
    "embedder"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Embedder degradation",
  "uid": "loom-embedder-degradation",
  "version": 1
}
